# Project defaults applied by `idf.py set-target` (committed; the generated
# sdkconfig is not). Tuned for the ESP32-D0WD board on this machine.

# This board's crystal is marginal — pin the XTAL to 40 MHz so the UART baud
# stays put across boots (otherwise some boots derive the clock from 26 MHz
# and shift the console baud).
CONFIG_ESP32_XTAL_FREQ_40=y

# Console baud the host reader expects.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# --- OTA + storage / sealed-unit ---
# Full 4 MB flash with a custom table: factory + ota_0 + ota_1 + a LittleFS
# "storage" partition (~960 KB) for the circular event log.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Auto-roll-back an OTA image that never reaches "mark valid" to the previous app.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
